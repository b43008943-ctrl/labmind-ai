# ═══════════════════════════════════════════════
#  LabMind AI — Backend Environment Configuration
# ═══════════════════════════════════════════════
# Copy this file to .env and fill in real values:
#   cp .env.example .env

# ── Application ──
APP_NAME=LabMind AI
APP_VERSION=1.0.0
DEBUG=true

# ── Database (PostgreSQL) ──
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/labmind_db

# ── JWT Authentication ──
JWT_SECRET_KEY=change-this-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS (comma-separated origins) ──
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Google Gemini ──
GEMINI_API_KEY=your-gemini-api-key-here

# ── Celery / Redis ──
REDIS_URL=redis://localhost:6379/0

# ── File Storage ──
UPLOAD_DIR=uploads

# ── V34 Engine Model Paths ──
YOLO_MODEL_PATH=blood_ai_v2.pt
CNN_MODEL_PATH=cell_classifier_2class_robust_v3_best.pth
