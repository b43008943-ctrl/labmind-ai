*.py[cod]
*.pyo
.venv/
*.egg-info/

# ─── Node ───
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ─── Environment files (contain secrets) ───
.env
.env.local
.env.production
.env.*.local

