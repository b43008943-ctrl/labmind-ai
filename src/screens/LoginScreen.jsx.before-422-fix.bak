            <circle cx="50" cy="67.5" r="14" fill="rgba(34,211,238,0.1)" stroke="rgba(34,211,238,0.6)" strokeWidth="1" strokeDasharray="3 2" className="login-spin-slow origin-center" />
            <circle cx="50" cy="67.5" r="10" fill="none" stroke="rgba(34,211,238,0.8)" strokeWidth="1.5" strokeDasharray="6 4" className="login-spin-reverse origin-center" />
