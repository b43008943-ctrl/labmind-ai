import { useState, useEffect } from 'react';
import { ArrowLeft, Bug, Activity, RefreshCw, FileText } from 'lucide-react';
import FinalReportModal from '../components/FinalReportModal';
import SidebarNavigation from '../components/SidebarNavigation';
import { motion, AnimatePresence } from 'framer-motion';


const samples = [
    { id: 'p-1', name: 'Entamoeba histolytica', desc: 'Cyst stage - 4 nuclei', colorClass: 'bg-[#5b6e1f]/80', microscopeImageUrl: '/p1.jpg', condition: 'normal' },
    { id: 'p-2', name: 'Giardia lamblia', desc: 'Trophozoite - Pear shaped', colorClass: 'bg-lime-500/80', microscopeImageUrl: '/p2.jpg', condition: 'infection' }
];

const resultsData = {
    'p-1': {
        parasiteId: "E. histolytica", parasiteStatus: "CONFIRMED", stage: "Cyst", stageStatus: "INFECTIOUS", pathogenic: "HIGH", pathogenicStatus: "CRITICAL", density: "15-20", densityStatus: "HIGH", insight: "Detection of E. histolytica cysts indicates active amebiasis. Recommend immediate pharmacological intervention.", readout: "> Parasite ID: Confirmed.\n> Life Cycle Stage: Cyst.\n> Pathogenic Status: HIGH.",
        challengeBank: [
            { question: 'A stool sample reveals round cysts with 4 nuclei and a chromatoidal bar. Which parasite is this?', options: ['Giardia lamblia', 'Entamoeba coli', 'Entamoeba histolytica'], correctAnswer: 'Entamoeba histolytica', explanation: 'E. histolytica mature cysts are characteristically round with 4 nuclei and chromatoidal bars with rounded ends.' },
            { question: 'Which complication is most feared in invasive E. histolytica infection?', options: ['Amoebic Liver Abscess', 'Appendicitis', 'Peptic Ulcer'], correctAnswer: 'Amoebic Liver Abscess', explanation: 'E. histolytica trophozoites can invade the intestinal wall and travel via the portal vein to the liver, causing amoebic liver abscess.' },
            { question: 'What is the drug of choice for treating invasive amebiasis?', options: ['Albendazole', 'Metronidazole', 'Praziquantel'], correctAnswer: 'Metronidazole', explanation: 'Metronidazole (Flagyl) is the first-line treatment for invasive amebiasis, followed by a luminal agent like paromomycin to eliminate cysts.' }
        ]
    },
    'p-2': {
        parasiteId: "G. lamblia", parasiteStatus: "CONFIRMED", stage: "Trophozoite", stageStatus: "ACTIVE", pathogenic: "MODERATE", pathogenicStatus: "WARNING", density: "10-15", densityStatus: "ELEVATED", insight: "G. lamblia trophozoites identified with typical 'falling leaf' motility. Correlate with gastrointestinal symptoms.", readout: "> Parasite ID: Confirmed.\n> Life Cycle Stage: Trophozoite.\n> Pathogenic Status: MODERATE.",
        challengeBank: [
            { question: "You observe a pear-shaped trophozoite with two nuclei and 'falling leaf' motility. Which parasite is this?", options: ['Entamoeba histolytica', 'Giardia lamblia', 'Trichomonas vaginalis'], correctAnswer: 'Giardia lamblia', explanation: "Giardia lamblia trophozoites are pear-shaped with two nuclei and characteristic 'falling leaf' motility." },
            { question: 'Giardia lamblia primarily attaches to which part of the intestine?', options: ['Colon', 'Duodenum', 'Stomach'], correctAnswer: 'Duodenum', explanation: 'Giardia trophozoites use their ventral sucking disc to attach to the duodenal and jejunal mucosa, causing malabsorption.' },
            { question: 'Which symptom is most characteristic of giardiasis?', options: ['Bloody diarrhea', 'Foul-smelling fatty stool (steatorrhea)', 'Constipation'], correctAnswer: 'Foul-smelling fatty stool (steatorrhea)', explanation: 'Giardia causes fat malabsorption by coating the intestinal villi, producing characteristic foul-smelling, greasy, floating stools.' }
        ]
    }
};

export default function ParasitologyLabScreen({ onNavigate }) {
    const [screenState, setScreenState] = useState('screen-transition-hidden');
    const [activeSlide, setActiveSlide] = useState(null);
    const [isScanning, setIsScanning] = useState(false);
    const [report, setReport] = useState(null);
    const [fineFocus, setFineFocus] = useState(50);
    const [isReportOpen, setIsReportOpen] = useState(false);
    const [magnification, setMagnification] = useState(40);
    const [activeSample, setActiveSample] = useState(null);
    const [reportStatus, setReportStatus] = useState(null);

    const blurAmount = Math.abs(fineFocus - 50) * 0.15;

    useEffect(() => {
        const t = setTimeout(() => setScreenState('screen-visible'), 50);
        return () => clearTimeout(t);
    }, []);

    const handleNavigation = (target) => {
        setScreenState('screen-exit');
        setTimeout(() => onNavigate(target), 600);
    };

    const handleDrop = (e, slideId) => {
        e.preventDefault();
        const id = slideId || e.dataTransfer.getData('slideId');
        if (id && resultsData[id]) {
            const selectedSample = samples.find(s => s.id === id);
            setActiveSample(selectedSample);
            setActiveSlide(id);
            setIsScanning(true);
            setReport(null);
            setReportStatus('scanning');
            setIsReportOpen(false);
            setTimeout(() => {
                setIsScanning(false);
                setReport(resultsData[id]);
                setReportStatus('ready');
            }, 2000);
        }
    };

    return (
        <div id="parasitology-lab-screen" className={`absolute inset-0 z-50 flex flex-col backdrop-blur-3xl min-h-dvh w-full overflow-y-auto overflow-x-hidden scroll-smooth pb-32 ${screenState}`} style={{ opacity: 1 }}>
            <div className="w-full h-full max-w-[1400px] mx-auto flex flex-col relative z-50">

                {/* Header - 20% smaller */}
                <header className="pt-6 md:pt-8 pb-3 px-4 md:px-6 flex justify-between items-center border-b border-white/5 bg-linear-to-b from-emerald-900/10 to-transparent shrink-0">
                    <div className="flex items-center gap-3">
                        <button
                            onClick={() => handleNavigation('virtual-lab')}
                            className="btn-back-glow w-8 h-8 rounded-lg flex items-center justify-center text-emerald-300 hover:text-emerald-400 hover:drop-shadow-[0_0_8px_rgba(16,185,129,0.8)] transition-all"
                        >
                            <ArrowLeft className="w-4 h-4" />
                        </button>
                        <div>
                            <h2 className="text-base md:text-lg font-bold text-white tracking-tight flex items-center gap-2">
                                <span className="text-emerald-400 drop-shadow-[0_0_8px_rgba(52,211,153,0.8)]">
                                    <Bug className="w-5 h-5 inline" />
                                </span>
                                <span className="theme-text">Parasitology Laboratory</span>
                            </h2>
                            <p className="text-[9px] text-emerald-400 mt-0.5 theme-text-muted">Pathogenic Micro-Organism Scan</p>
                        </div>
                    </div>
                </header>

                <SidebarNavigation onNavigate={handleNavigation} />

                {/* Main Lab Workspace */}
                <div className={`flex-1 flex-col md:flex-row overflow-visible p-4 md:p-6 gap-6 md:gap-8 ${isReportOpen ? 'hidden' : 'flex'}`}>

                    {/* LEFT: Microscope Viewport */}
                    <div className="flex-1 flex flex-col items-center gap-4">
                        <div className="w-64 h-64 sm:w-80 sm:h-80 rounded-full border-2 border-dashed border-emerald-500/30 flex items-center justify-center text-emerald-500/50 font-mono text-xs tracking-widest text-center p-6">
                            [MICROSCOPE LENS MODULE PURGED]
                        </div>

                        {/* Bottom Controls */}
                        <div className="shrink-0 h-12 rounded-2xl p-2 flex items-center justify-between mt-4 shadow-[0_10px_30px_rgba(0,0,0,0.8)] w-max max-w-full" style={{ background: 'rgba(10, 15, 25, 0.75)', backdropFilter: 'blur(16px)', border: '1px solid rgba(16, 185, 129, 0.3)' }}>
                            <div className="flex items-center gap-3">
                                <div className="flex flex-col">
                                    <span className="text-[6px] text-emerald-500 uppercase tracking-widest font-bold mb-0.5">Magnification</span>
                                    <div className="flex rounded-lg p-0.5 gap-1">
                                        <button
                                            onClick={() => setMagnification(40)}
                                            className={`px-2.5 py-0.5 text-[8px] font-bold rounded tracking-widest transition-all duration-300 ${magnification === 40
                                                ? 'text-emerald-300 bg-emerald-500/20 border border-emerald-500/50 shadow-[0_0_10px_rgba(16,185,129,0.3)]'
                                                : 'text-gray-500 border border-transparent hover:text-gray-300 hover:border-white/10'
                                                }`}
                                        >40x</button>
                                        <button
                                            onClick={() => setMagnification(100)}
                                            className={`px-2.5 py-0.5 text-[8px] font-bold rounded tracking-widest transition-all duration-300 ${magnification === 100
                                                ? 'text-emerald-300 bg-emerald-500/20 border border-emerald-500/50 shadow-[0_0_10px_rgba(16,185,129,0.3)]'
                                                : 'text-gray-500 border border-transparent hover:text-gray-300 hover:border-white/10'
                                                }`}
                                        >100x</button>
                                    </div>
                                </div>
                                <div className="flex flex-col w-28 md:w-36 justify-center">
                                    <span className="text-[6px] text-emerald-500 uppercase tracking-widest font-bold mb-0.5">Fine Focus</span>
                                    <input type="range" min="1" max="100" value={fineFocus} onChange={(e) => setFineFocus(parseInt(e.target.value))} className="w-full accent-emerald-500 h-1 bg-gray-800 rounded-lg appearance-none cursor-pointer" />
                                </div>
                            </div>
                            <div className="text-right hidden sm:block ml-3 pl-3 border-l border-white/10">
                                <span className={`text-[8px] font-bold tracking-widest transition-colors ${blurAmount < 1.0 ? 'text-emerald-400 animate-pulse shadow-[0_0_8px_rgba(16,185,129,0.6)]' : 'text-rose-500'}`}>
                                    {blurAmount < 1.0 ? 'OPTICS ALIGNED' : 'BLURRED'}
                                </span>
                            </div>
                        </div>

                    </div>

                    {/* RIGHT: Sample Tray */}
                    <div className="w-full md:w-80 flex flex-col gap-4 md:gap-6 min-h-0 shrink-0 font-rajdhani relative z-50 pointer-events-auto">
                        <div className="rounded-3xl flex-1 flex flex-col min-h-0 bg-slate-900/60 backdrop-blur-md border border-emerald-500/20 shadow-[0_0_20px_rgba(16,185,129,0.05)] p-4">
                            <h3 className="text-xs font-bold text-white uppercase tracking-widest mb-3 flex items-center gap-2 border-b border-emerald-500/30 pb-3 drop-shadow-[0_0_8px_rgba(255,255,255,0.4)]">
                                <Bug className="w-3.5 h-3.5 text-emerald-400 hover:drop-shadow-[0_0_8px_rgba(16,185,129,0.8)] transition-all duration-300" /> PARASITE SAMPLES
                            </h3>

                            <div className="flex flex-col gap-3 overflow-y-auto flex-1 no-scrollbar pb-20">
                                {samples.map(sample => (
                                    <div
                                        key={sample.id}
                                        onClick={() => {
                                            setActiveSample(sample);
                                            setActiveSlide(sample.id);
                                            setIsScanning(true);
                                            setReport(null);
                                            setReportStatus('scanning');
                                            setIsReportOpen(false);
                                            setTimeout(() => {
                                                setIsScanning(false);
                                                setReport(resultsData[sample.id]);
                                                setReportStatus('ready');
                                            }, 2000);
                                        }}
                                        className={`group relative z-50 pointer-events-auto bg-black/40 border rounded-xl p-3 cursor-pointer hover:bg-slate-800 hover:border-emerald-400 hover:shadow-[0_0_20px_rgba(16,185,129,0.4)] transform hover:scale-[1.02] transition-all duration-300 ${activeSample?.id === sample.id ? 'border-emerald-400/80 bg-slate-800/80 shadow-[0_0_15px_rgba(16,185,129,0.2)]' : 'border-white/10'}`}
                                    >
                                        <div className="flex items-center gap-3">
                                            <div className="relative w-10 h-6 bg-white/5 border border-white/20 rounded-sm flex items-center justify-center">
                                                <div className={`w-4 h-4 rounded-full blur-[1px] ${sample.colorClass}`}></div>
                                                {activeSample?.id === sample.id && (
                                                    <div className="absolute -top-1 -right-1 w-2.5 h-2.5 rounded-full bg-emerald-400 shadow-[0_0_10px_rgba(16,185,129,0.9)] z-50 animate-pulse" />
                                                )}
                                            </div>
                                            <div>
                                                <h4 className="text-[14px] font-bold text-[#E0FFFF] group-hover:text-white tracking-wide">{sample.name}</h4>
                                                <p className="text-[10px] text-gray-300 font-medium leading-relaxed mt-0.5">{sample.desc}</p>
                                            </div>
                                        </div>
                                    </div>
                                ))}
                            </div>

                            <div className="mt-auto pt-3 text-center">
                                <p className="text-[9px] text-gray-500 font-mono">CLICK OR DRAG SLIDE TO MOUNT</p>
                            </div>
                        </div>

                        {/* CELLULAR CHANGE TRACKING CONTAINER */}
                        <AnimatePresence>
                            {!isReportOpen && (
                                <motion.div
                                    initial={{ opacity: 0, y: 50 }}
                                    animate={{ opacity: 1, y: 0 }}
                                    exit={{ opacity: 0, y: 50 }}
                                    transition={{ duration: 0.5, ease: "easeInOut" }}
                                    className="rounded-3xl bg-slate-900/80 backdrop-blur-md border border-white/10 shadow-[0_0_20px_rgba(0,0,0,0.5)] p-4 flex flex-col shrink-0 cursor-default pointer-events-auto"
                                >
                                    <h3 className="text-xs font-bold text-emerald-400 uppercase tracking-widest mb-3 flex items-center justify-between border-b border-white/5 pb-3">
                                        <span className="flex items-center gap-2 drop-shadow-[0_0_8px_rgba(52,211,153,0.8)]">
                                            <Activity className="w-3.5 h-3.5" /> CELLULAR CHANGE TRACKING
                                        </span>
                                        <RefreshCw className={`w-3.5 h-3.5 text-emerald-600 ${isScanning ? 'animate-spin text-emerald-400' : ''}`} />
                                    </h3>

                                    <div className="bg-black/50 rounded-xl p-3 border border-emerald-900/30 font-mono text-[10px] sm:text-[11px] text-emerald-300 leading-relaxed min-h-[80px]">
                                        {isScanning ? (
                                            <span className="opacity-50 animate-pulse">&gt; SCANNING INITIALIZED...<br />&gt; AWAITING TELEMETRY...</span>
                                        ) : activeSample ? (
                                            <span>
                                                {activeSample.id === 'p-1' && <>&gt; Parasite ID: Confirmed.<br />&gt; Life Cycle Stage: Cyst.<br /><span className="text-[#5b6e1f] drop-shadow-[0_0_8px_#5b6e1f] font-bold">&gt; Pathogenic Status: HIGH.</span></>}
                                                {activeSample.id === 'p-2' && <>&gt; Parasite ID: Confirmed.<br />&gt; Life Cycle Stage: Trophozoite.<br /><span className="text-lime-400 drop-shadow-[0_0_8px_#a3e635] font-bold">&gt; Pathogenic Status: MODERATE.</span></>}
                                            </span>
                                        ) : (
                                            <span className="opacity-30 text-slate-500">&gt; SYSTEM STANDBY<br />&gt; NO SAMPLE MOUNTED</span>
                                        )}
                                    </div>

                                    {reportStatus === 'ready' && (
                                        <button
                                            onClick={() => setIsReportOpen(true)}
                                            className="mt-3 w-full border border-emerald-500/50 bg-emerald-950/30 hover:bg-emerald-900/50 text-emerald-400 font-bold tracking-widest uppercase text-[10px] py-2 rounded-lg transition-all flex items-center justify-center gap-2 hover:shadow-[0_0_15px_rgba(52,211,153,0.4)]"
                                        >
                                            <FileText className="w-3.5 h-3.5" /> View Final Report
                                        </button>
                                    )}

                                    <div className="mt-3 text-right">
                                        <p className="text-[8px] text-slate-500 font-bold tracking-widest uppercase">POWERED BY CHANGE INTELLIGENCE</p>
                                    </div>
                                </motion.div>
                            )}
                        </AnimatePresence>
                    </div>
                </div>
            </div>

            {/* Full-Screen Final Report Modal */}
            <FinalReportModal
                isOpen={isReportOpen}
                onClose={() => setIsReportOpen(false)}
                reportData={report}
                activeSample={activeSample}
                sampleType="parasitology"
            />
        </div >
    );
}
